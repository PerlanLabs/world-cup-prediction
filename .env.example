# Local HTTP service. Non-loopback HOST values require a strong ADMIN_TOKEN.
HOST=127.0.0.1
PORT=8787
ADMIN_TOKEN=
CORS_ORIGIN=
MAX_JSON_BODY_BYTES=10485760

# Local persistence
PREDICTION_STORE_DRIVER=sqlite
PREDICTION_STORE_PATH=prediction-api/data/backend-store.sqlite

# Optional external data and explanation providers
API_FOOTBALL_KEY=
DEEPSEEK_API_KEY=

# Optional Polymarket PaperTrader CLI/runtime overrides
PAPERTRADER_EXE=
PAPERTRADER_DATA_DIR=
